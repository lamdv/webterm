{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webterm",
  "version": "0.1.0",
  "identifier": "dev.webterm.desktop",
  "build": {
    "frontendDist": "../src/webterm_desktop/frontend",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "webterm",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
